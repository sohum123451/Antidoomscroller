{
  "manifest_version": 3,
  "key": "",
  "name": "Checkpoint",
  "version": "0.1.0",
  "description": "Answer a question before the next reel, and before you keep chatting.",
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "oauth2": {
    "client_id": "26126776554-2dmsuofnmvm67eamo70sdinga0ibflde.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.tiktok.com/*",
    "*://*.snapchat.com/*",
    "*://web.whatsapp.com/*",
    "*://*.discord.com/*",
    "*://web.telegram.org/*",
    "*://*.messenger.com/*",
    "*://*.reddit.com/*",
    "https://*.workers.dev/*",
    "https://checkpoint-api.sohum123451.workers.dev/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.tiktok.com/*",
        "*://*.snapchat.com/*",
        "*://web.whatsapp.com/*",
        "*://*.discord.com/*",
        "*://web.telegram.org/*",
        "*://*.messenger.com/*",
        "*://*.reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Checkpoint"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}