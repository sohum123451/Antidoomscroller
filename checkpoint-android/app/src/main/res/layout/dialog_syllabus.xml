<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#16223D"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSyllabusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Syllabus Topics"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Toggle topics on or off to customize your question stream"
        android:textColor="#8E99AF"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progressSyllabus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:indeterminateTint="#4D72D9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/containerTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnCloseSyllabus"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Done" />

</LinearLayout>
